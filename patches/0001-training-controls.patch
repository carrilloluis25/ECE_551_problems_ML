+def save_checkpoint(states, log_path, step):
+    """Write ckpt_<step>.pth atomically, then point ckpt.pth at it (also atomically).
+
+    A kill during the write leaves a stray .tmp file instead of a truncated checkpoint,
+    and ckpt.pth always names the newest complete checkpoint.
+    """
+    numbered = os.path.join(log_path, "ckpt_{}.pth".format(step))
+    tmp = numbered + ".tmp"
+    torch.save(states, tmp)
+    os.replace(tmp, numbered)
+    latest = os.path.join(log_path, "ckpt.pth")
+    link = latest + ".lnk"
+    if os.path.lexists(link):
+        os.remove(link)
+    os.symlink(os.path.basename(numbered), link)
+    os.replace(link, latest)
+
